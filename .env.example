# This service calls: GET {CERT_API_URL}?id=<id>
# e.g. CERT_API_URL=https://lysbot-production.up.railway.app/api/verify
CERT_API_URL=https://lysbot-production.up.railway.app/api/verify

# Base URL the "Verify" QR code points to (becomes {PUBLIC_VERIFY_URL}?id=<id>).
# Defaults to this service's own certificate page if unset.
PUBLIC_VERIFY_URL=
